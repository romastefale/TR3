from typing import Any, Dict, Optional
import json
import threading
import time
import os
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin
from client_utils import get_last_fragment, send_request, download_file
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
from org.telegram.tgnet import functions, TLRPC
class MTProtoRpcMarkdownReportPlugin(BasePlugin):
    """
    Plugin para ler JSON forense enviado como anexo, processar e gerar relatório Markdown.
    """
    def on_plugin_load(self) -> None:
        self.log("Markdown Report Plugin carregado")
    def on_plugin_unload(self) -> None:
        self.log("Markdown Report Plugin descarregado")
    def on_message(self, message: Any) -> None:
        text = getattr(message, "message", "")
        if not text or not text.startswith(".read"):
            return
        reply_msg = getattr(message, "reply_to_msg", None)
        if not reply_msg:
            self._show_error("Use o comando '.read' em resposta a mensagem com anexo JSON.")
            return
        media = getattr(reply_msg, "media", None)
        if not media:
            self._show_error("A mensagem respondida não contém anexo.")
            return
        document = getattr(media, "document", None)
        if not document:
            self._show_error("O anexo não é um documento válido.")
            return
        file_name = getattr(document, "file_name", "") or ""
        if not file_name.lower().endswith(".json"):
            self._show_error("O anexo deve ser um arquivo JSON.")
            return
        threading.Thread(target=self._process_attachment, args=(message, reply_msg, document)).start()
    def _process_attachment(self, command_msg: Any, replied_msg: Any, document: Any) -> None:
        chat_id = getattr(command_msg, "chat_id", None)
        if not chat_id:
            self._show_error("Erro: chat desconhecido.")
            return
        self._show_info("Iniciando download do arquivo JSON...")
        # Download do arquivo JSON usando helper do SDK (ajuste conforme seu ambiente)
        try:
            file_path = download_file(document)
        except Exception as e:
            self._show_error("Falha ao baixar o arquivo JSON.")
            self.log(f"Erro download_file: {e}")
            return
        try:
            with open(file_path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except Exception as e:
            self._show_error(f"Falha ao ler JSON: {e}")
            os.remove(file_path)
            return
        os.remove(file_path)
        self._show_info("Gerando relatório Markdown...")
        markdown_text = self._generate_markdown(data)
        # Salvar arquivo Markdown temporário
        md_path = self._save_markdown(chat_id, markdown_text)
        if not md_path:
            self._show_error("Erro ao salvar arquivo Markdown.")
            return
        # Enviar arquivo Markdown
        if self._send_markdown(chat_id, md_path, replied_msg.get_id()):
            self._show_info("Relatório Markdown enviado com sucesso.")
        else:
            self._show_error("Falha ao enviar relatório Markdown.")
        os.remove(md_path)
    def _generate_markdown(self, data: dict) -> str:
        lines = ["# Relatório Forense MTProto", ""]
        def add_section(title):
            lines.append(f"## {title}\n")
        def add_kv(key, value):
            lines.append(f"- **{key}**: {value if value is not None else 'N/A'}")
        self_user = data.get("self_user")
        if self_user:
            add_section("Conta Ativa (Self User)")
            if 'error' in self_user:
                lines.append(f"Erro: {self_user['error']}")
            else:
                add_kv("ID", self_user.get("id"))
                add_kv("Nome", f"{self_user.get('first_name', '')} {self_user.get('last_name', '')}".strip())
                add_kv("Username", self_user.get("username"))
                add_kv("Status", str(self_user.get("status")))
            lines.append("")
        chat_full = data.get("chat_full")
        if chat_full:
            add_section("Chat Completo")
            chat = chat_full.get("chat", {})
            add_kv("ID", chat.get("id"))
            add_kv("Título", chat.get("title"))
            add_kv("Tipo", chat.get("type"))
            linked = chat_full.get("linked_chat_id")
            if linked:
                add_kv("Chat Vinculado", linked)
            lines.append("")
        participants = data.get("participants", {})
        if participants:
            add_section("Participantes")
            users = participants.get("users") or []
            for u in users:
                name = u.get("first_name") or u.get("username") or "Desconhecido"
                add_kv("Usuário", name)
            lines.append("")
        config = data.get("config")
        if config:
            add_section("Configuração do Cliente")
            if 'error' in config:
                lines.append(f"Erro: {config['error']}")
            else:
                for k, v in list(config.items())[:10]:  # Limita output para campos principais
                    add_kv(k, v)
            lines.append("")
        user_full = data.get("user_full")
        if user_full:
            add_section("Dados Completos do Interlocutor")
            if 'error' in user_full:
                lines.append(f"Erro: {user_full['error']}")
            else:
                add_kv("ID", user_full.get("id"))
                add_kv("Nome", f"{user_full.get('first_name', '')} {user_full.get('last_name', '')}".strip())
                add_kv("Username", user_full.get("username"))
            lines.append("")
        meta = data.get("meta")
        if meta:
            add_section("Metadados")
            for k, v in meta.items():
                add_kv(k, v)
            lines.append("")
        lines.append("*Relatório gerado automaticamente pelo plugin*")
        return "\n".join(lines)
    def _save_markdown(self, chat_id: int, content: str) -> Optional[str]:
        try:
            path = f"/tmp/relatorio_forense_{chat_id}_{int(time.time())}.md"
            with open(path, "w", encoding="utf-8") as f:
                f.write(content)
            return path
        except Exception as e:
            self.log(f"Erro salvando Markdown: {e}")
            return None
    def _send_markdown(self, chat_id: int, file_path: str, reply_to_msg_id: int) -> bool:
        try:
            input_peer = TLRPC.TL_inputPeerChat()
            input_peer.chat_id = chat_id
            input_file = TLRPC.TL_inputMediaUploadedDocument()
            input_file.file = TLRPC.TL_inputFileLocal()
            input_file.file.path = file_path
            input_file.mime_type = "text/markdown"
            input_file.attributes = []
            req = functions.messages.SendMedia()
            req.peer = input_peer
            req.media = input_file
            req.message = "Relatório Forense"
            req.random_id = int(time.time())
            req.reply_to_msg_id = reply_to_msg_id
            # Envia requisição, callback opcional para logging
            send_request(req, lambda res, err: self.log(f"Arquivo enviado, erro: {err}") if err else None)
            return True
        except Exception as e:
            self.log(f"Erro enviando arquivo: {e}")
            return False
    @staticmethod
    def _show_info(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
    @staticmethod
    def _show_error(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))
