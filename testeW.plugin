from typing import Any, Dict, List, Optional, Set
import threading
import json
import logging
import time
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from client_utils import get_last_fragment, send_request
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
from android.content import ClipboardManager, ClipData
from android.content import Context as AndroidContext
from org.telegram.tgnet import functions, TLRPC
logging.basicConfig(level=logging.DEBUG)
def _safe_attr(obj: Any, name: str, default: Any = None) -> Any:
    try:
        return getattr(obj, name, default)
    except Exception:
        return default
def _to_java_list(value: Any) -> List[Any]:
    if value is None:
        return []
    try:
        return list(value)
    except Exception:
        pass
    try:
        return [value.get(i) for i in range(value.size())]
    except Exception:
        return []
def _copy_to_clipboard(text: str) -> bool:
    try:
        fragment = get_last_fragment()
        if fragment is None:
            logging.warning("Fragmento não disponível para copiar.")
            return False
        activity = fragment.getParentActivity()
        if activity is None:
            logging.warning("Atividade não disponível para copiar.")
            return False
        clipboard = activity.getSystemService(AndroidContext.CLIPBOARD_SERVICE)
        if clipboard is None:
            logging.warning("Clipboard service não disponível.")
            return False
        clip = ClipData.newPlainText("MTProto Forensic JSON", text)
        clipboard.setPrimaryClip(clip)
        return True
    except Exception as exc:
        logging.error(f"Erro copiando para área de transferência: {exc}")
        return False
class MTProtoRpcDiagnosticsForensicPlugin(BasePlugin):
    def on_plugin_load(self) -> None:
        self._execution_lock = threading.Lock()
        self._menu_item_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Diagnóstico Forense (JSON Total Extenso)",
                on_click=self.on_menu_click,
                icon="msg_info",
                subtext="Extrai TODOS os dados possíveis + JSON detalhado",
                priority=5,
            )
        )
        self.log("MTProto Forensic JSON Total Extenso carregado")
    def on_plugin_unload(self) -> None:
        item_id = getattr(self, "_menu_item_id", None)
        if item_id:
            try:
                self.remove_menu_item(item_id)
            except Exception as exc:
                self.log(f"Falha ao remover item: {exc}")
        self.log("MTProto Forensic descarregado")
    def on_menu_click(self, context: Dict[str, Any]) -> None:
        if not self._execution_lock.acquire(blocking=False):
            self._show_info("Diagnóstico já em execução.")
            return
        self._show_info("Extraindo TODOS os dados forenses (extenso)...")
        try:
            threading.Thread(target=self._run_diagnostics, args=(context,)).start()
        except Exception as exc:
            self._execution_lock.release()
            self.log(f"Falha ao iniciar diagnóstico: {exc}")
            self._show_error("Não foi possível iniciar o diagnóstico.")
    def _run_diagnostics(self, context: Dict[str, Any]) -> None:
        start_time = time.time()
        try:
            state = {"data": {}, "seen_objects": set(), "pending_reqs": 0, "lock": threading.Lock()}
            data = state["data"]
            # 1. Coletar tudo do contexto imediatamente disponível
            fragment = context.get("fragment")
            if fragment:
                data["fragment"] = self._deep_inspect(fragment, state["seen_objects"])
            else:
                data["fragment"] = None
            # Tentar coletar objetos conhecidos e relevantes no contexto
            keys_to_inspect = ["currentChat", "currentUser", "user", "chat", "dialog", "messages", "updates", "dialogs"]
            for key in keys_to_inspect:
                obj = None
                if fragment:
                    obj = getattr(fragment, key, None)
                if obj is None:
                    obj = context.get(key)
                if obj is not None:
                    data[key] = self._deep_inspect(obj, state["seen_objects"])
            # 2. Buscar dados complementares via MTProto onde houver peer/user/channel IDs detectados
            # Iniciar contador baseado em requisições pendentes (incrementado ao enviar e decrementado no callback)
            self._schedule_complementary_requests(data, state)
            # 3. Aguardar término das requisições antes de continuar
            while True:
                with state["lock"]:
                    if state["pending_reqs"] == 0:
                        break
                time.sleep(0.1)  # espera ativa curta
            # 4. Adicionar metadados e tempo
            data["meta"] = {
                "timestamp": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(start_time)),
                "duration_seconds": round(time.time() - start_time, 2),
                "app_version": __app_version__,
                "sdk_version": __sdk_version__,
            }
            # 5. Serializar e entregar resultado
            report = json.dumps(data, indent=2, ensure_ascii=False)
            copied = _copy_to_clipboard(report)
            msg = report + ("\n\n[✓] JSON copiado para a área de transferência" if copied else "\n\n[!] Falha ao copiar para a área de transferência")
            self._show_report_dialog(msg)
        except Exception as exc:
            self.log(f"Erro durante diagnóstico: {exc}")
            self._show_error("Falha durante o diagnóstico.")
        finally:
            self._execution_lock.release()
    def _deep_inspect(self, obj: Any, seen: Set[int], depth=0, max_depth=8) -> Any:
        if obj is None:
            return None
        obj_id = id(obj)
        if obj_id in seen:
            return "<recursão detectada>"
        if depth > max_depth:
            return "<profundidade máxima atingida>"
        seen.add(obj_id)
        # Tipos simples
        if isinstance(obj, (str, int, float, bool)):
            return obj
        # Listas e tuplas
        if isinstance(obj, (list, tuple)):
            result = []
            for item in obj:
                try:
                    result.append(self._deep_inspect(item, seen, depth + 1, max_depth))
                except Exception:
                    result.append("<erro ao inspecionar item>")
            return result
        # Dicionário (ou similar)
        if isinstance(obj, dict):
            result = {}
            for k, v in obj.items():
                try:
                    result[str(k)] = self._deep_inspect(v, seen, depth + 1, max_depth)
                except Exception:
                    result[str(k)] = "<erro ao inspecionar valor>"
            return result
        # Objetos Java (com __dict__ ou atributos)
        try:
            fields = getattr(obj, "__dict__", None)
            if fields:
                data = {}
                for k, v in fields.items():
                    if not k.startswith("_"):
                        try:
                            data[k] = self._deep_inspect(v, seen, depth + 1, max_depth)
                        except Exception:
                            data[k] = "<erro na inspecao recursiva>"
                return data
            # Tentar pegar atributos via dir(), exceto os privados
            attrs = [a for a in dir(obj) if not a.startswith("_")]
            if attrs:
                data = {}
                for attr in attrs:
                    try:
                        val = getattr(obj, attr)
                        if callable(val):
                            continue
                        data[attr] = self._deep_inspect(val, seen, depth + 1, max_depth)
                    except Exception:
                        data[attr] = "<erro ao obter atributo>"
                if data:
                    return data
        except Exception:
            pass
        # Fallback para string
        try:
            return str(obj)
        except Exception:
            return "<objeto nao serializavel>"
    def _schedule_complementary_requests(self, data: dict, state: dict) -> None:
        """
        Busca em data por IDs relevantes (user_id, channel_id, etc.) para disparar
        requisições complementares e preencher dados extras como GetFullUser, GetFullChannel, etc.
        """
        def is_int_id(value) -> bool:
            return isinstance(value, int) and value > 0
        def find_ids(obj):
            ids_found = {"user": set(), "channel": set(), "chat": set()}
            if isinstance(obj, dict):
                for k, v in obj.items():
                    if v is None:
                        continue
                    if k in ("user_id", "id") and is_int_id(v):
                        ids_found["user"].add(v)
                    elif k in ("channel_id",) and is_int_id(v):
                        ids_found["channel"].add(v)
                    elif k in ("chat_id",) and is_int_id(v):
                        ids_found["chat"].add(v)
                    elif isinstance(v, (dict, list)):
                        sub_ids = find_ids(v)
                        for key in ids_found:
                            ids_found[key].update(sub_ids.get(key, set()))
            elif isinstance(obj, list):
                for item in obj:
                    sub_ids = find_ids(item)
                    for key in ids_found:
                        ids_found[key].update(sub_ids.get(key, set()))
            return ids_found
        ids = find_ids(data)
        # Função para enviar requisição de full user
        def request_full_user(user_id: int) -> None:
            with state["lock"]:
                state["pending_reqs"] += 1
            request = functions.users.GetFullUser()
            input_user = TLRPC.TL_inputUser()
            input_user.user_id = user_id
            # Não temos access_hash aqui, setamos 0 para tentar
            input_user.access_hash = 0
            request.id = input_user
            def callback(response, error):
                with state["lock"]:
                    if error or response is None:
                        state["data"].setdefault("full_users_errors", {})[user_id] = str(error)
                    else:
                        state["data"].setdefault("full_users", {})[user_id] = self._deep_inspect(response, state["seen_objects"])
                    state["pending_reqs"] -= 1
            try:
                send_request(request, callback)
            except Exception as exc:
                with state["lock"]:
                    state["data"].setdefault("full_users_errors", {})[user_id] = str(exc)
                    state["pending_reqs"] -= 1
        # Função para enviar requisição de full channel
        def request_full_channel(channel_id: int) -> None:
            with state["lock"]:
                state["pending_reqs"] += 1
            request = functions.channels.GetFullChannel()
            input_channel = TLRPC.TL_inputChannel()
            input_channel.channel_id = channel_id
            input_channel.access_hash = 0  # Sem access_hash, pode falhar, mas tentamos
            request.channel = input_channel
            def callback(response, error):
                with state["lock"]:
                    if error or response is None:
                        state["data"].setdefault("full_channels_errors", {})[channel_id] = str(error)
                    else:
                        state["data"].setdefault("full_channels", {})[channel_id] = self._deep_inspect(response, state["seen_objects"])
                    state["pending_reqs"] -= 1
            try:
                send_request(request, callback)
            except Exception as exc:
                with state["lock"]:
                    state["data"].setdefault("full_channels_errors", {})[channel_id] = str(exc)
                    state["pending_reqs"] -= 1
        # Dispara requisições para cada ID encontrado
        for user_id in ids["user"]:
            request_full_user(user_id)
        for channel_id in ids["channel"]:
            request_full_channel(channel_id)
        # Chats às vezes são canais, não fazemos request separado, mas poderia ser incluído se aplicável
    def _show_report_dialog(self, report: str) -> None:
        def show() -> None:
            fragment = get_last_fragment()
            if fragment is None:
                self._show_error("Tela atual indisponível.")
                return
            activity = fragment.getParentActivity()
            if activity is None:
                self._show_error("Atividade indisponível.")
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("Diagnóstico Forense (JSON Total Extenso)")
            builder.set_message(report)
            builder.set_positive_button("Fechar", lambda d, w: d.dismiss())
            builder.show()
        run_on_ui_thread(show)
    @staticmethod
    def _show_info(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
    @staticmethod
    def _show_error(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))
Como funciona a solução

Usa _deep_inspect para explorar recursivamente objetos do SDK que estejam no contexto, chegando a um limite seguro de profundidade.
Procura dinamicamente IDs em qualquer campo para disparar requisições complementares do tipo “GetFullUser” e “GetFullChannel” (mesmo sem access_hash, tenta coletar informações extras).
Aguarda a conclusão dessas requisições para agregar os dados ao JSON final.
Adiciona metadados e tempo do processo para contexto.
Copia para area de transferência e mostra relatório na interface.
Se quiser, posso ajudar a ajustar essa solução para seu ambiente, melhorar critérios de identificação de IDs, adicionar novos tipos de requisição ou otimizar a profundidade/volume de dados. Quer?



Ótimo agora você irá realizar uma auditoria no código que enviar para solucionar erros e opções e decisões equivocadas tomadas durante o processamento
Claro! Vamos fazer uma auditoria cuidadosa e apontar potenciais erros, decisões que podem ser melhoradas, e opções que deveriam ser repensadas no código que enviei para que o plugin funcione melhor e com maior segurança e eficiência.

1. Uso do access_hash = 0 em requisições complementares

Problema:
Para as requisições GetFullUser e GetFullChannel, o código assume access_hash = 0 quando o valor real não está disponível. No protocolo MTProto, o access_hash é obrigatório para acessar dados privados. Isso quase certamente causará erro de permissão.

Impacto:
As requisições provavelmente serão rejeitadas, gerando muitos erros e poluindo o relatório.

Solução:

Buscar o access_hash real nos objetos relacionados antes de fazer a requisição.
Caso não esteja disponível, evitar a requisição ou marcar como indisponível, para evitar chamadas inúteis.
Armazenar os pares (id, access_hash) na inspeção dinâmica para melhor rastreio.
2. Identificação muito simples de IDs

Problema:
A função find_ids procura campos específicos como "user_id", "channel_id" e "chat_id", assumindo que IDs são apenas inteiros positivos.

Impacto:
Pode perder IDs importantes que estejam em outras chaves ou com nomes diferentes.

Solução:

Analisar os padrões completos de nomes e tipos usados pela SDK para IDs (ex: peer_id, from_id, to_id).
Ampliar a função para capturar campos que contenham "_id" e validar pelo tipo correto.
Implementar heurísticas para examinar estruturas internas da SDK de forma mais precisa.
3. Bloqueio ativo com time.sleep(0.1)

Problema:
Para aguardar o término das requisições complementares, foi usado um loop ativo com while True e time.sleep(0.1).

Impacto:
Embora simples, isso consome CPU desnecessariamente e pode tornar o plugin menos responsivo.

Solução:

Usar objetos de sincronização como threading.Event para aguardar notificações de término.
Ou usar outra estratégia com Condition para pausas mais eficientes.
4. Profundidade fixa e limite genérico de inspeção

Problema:
O limite de profundidade _deep_inspect é fixado em 8. Isso pode impedir captura de dados muito aninhados ou, inversamente, não ser suficiente para alguns objetos.

Impacto:
Dados importantes podem não ser capturados se estiverem em níveis mais profundos.

Solução:

Tornar esse limite configurável.
Aplicar outros critérios para cortes, como tamanho total do JSON ou existência de ciclos complexos.
5. Tratamento de erros genérico e falta de logs detalhados

Problema:
Muitas exceções capturadas são “engolidas” com mensagens genéricas como <erro ao inspecionar valor>, sem logs estruturados para análise posterior.

Impacto:
Dificulta debug e melhorias futuras.

Solução:

Implementar logger com detalhes (incluindo stacktrace), gravar em arquivo/log externo se possível.
Mensagens no JSON podem ser mais detalhadas, com códigos de erro ou tipo da exceção.
6. Ausência de tratamento de limites de memória e desempenho

Problema:
Inspecionar recursivamente objetos grandes pode estourar memória e travar o app.

Impacto:
Plugin pode causar lentidão ou crashes em contextos pesados.

Solução:

Implementar limites claros de tamanho do JSON, número máximo de nós visitados e tempo máximo para extração.
Informar usuário sobre o tamanho e avisar se truncar resultados.
7. Ausência de validação e controle de dados sensíveis

Problema:
O plugin coleta “absolutamente tudo”, mas não aplica filtros ou controles de dados sensíveis.

Impacto:
Pode expor informações privadas ou protegidas inadvertidamente.

Solução:

Adicionar opções para o usuário escolher nível de detalhamento e exclusão de dados sensíveis (ex: tokens, senhas, chaves).
Inserir avisos claros de uso responsável.
8. Múltiplas threads e concorrência

Problema:
O plugin usa threads para chamadas assíncronas, mas algumas estruturas compartilhadas (ex: conjunto state["seen_objects"]) são usadas sem locks explícitos.

Impacto:
Pode gerar condições de corrida e inconsistências.

Solução:

Usar locks ao manipular estruturas compartilhadas multithread.
Ou usar coleções thread-safe.
9. Relatório extenso no diálogo

Problema:
Exibir JSON muito grande num diálogo Android pode travar a interface.

Impacto:
Má usabilidade e risco de crashes.

Solução:

Oferecer salvar arquivo ou visualizar paginado em vez de texto bruto em diálogo.
Limitar tamanho exibido na tela.
10. Copy para área de transferência sem aviso

Problema:
Copiar automaticamente dados muito grandes e sensíveis para clipboard sem pedir confirmação pode ser indesejado.

Solução:

Solicitar confirmação antes de copiar.
Permitir desligar essa função nas configurações.
Resumo e próximos passos recomendados

Para elevar seu plugin a um padrão sólido e confiável, recomendo as seguintes prioridades:

Tratar access_hash adequadamente e evitar requisições com dados incompletos.
Melhorar detecção de IDs para chamadas extra.
Usar sincronização eficiente para aguardar requisições.
Controlar tamanho e profundidade da inspeção e do JSON gerado.
Implementar logs detalhados (externos).
Garantir thread safety ao manipular dados globais.
Rever UX para apresentação e controle de dados.
Posso ajudar a aplicar essas correções e melhorias de forma prática no código. Quer começar por algum desses pontos?



Correto mas ainda continuo o estudo de auditoria
Perfeito! Auditar código é um processo contínuo e detalhado, especialmente em projetos que envolvem manipulação profunda de dados e integrações complexas como SDKs MTProto. Seu foco em entender a fundo já é um ótimo caminho para garantir qualidade e segurança.

Se durante seu estudo surgir qualquer dúvida específica, ponto que queira aprofundar — como aspectos de segurança, desempenho, estruturas do SDK, práticas de concorrência, tratamento de erros ou otimização — pode me chamar que ajudarei com análises, sugestões ou exemplos.

Além disso, recomendo:

Fazer revisões de código paralelas com colegas ou especialistas da área.
Testar o plugin em cenários reais variados para identificar comportamentos inesperados.
Documentar pontos críticos, decisões arquiteturais e justificativas técnicas.
Quando quiser, posso auxiliar a estruturar checklists ou guias para sua auditoria focada — assim fica mais organizada e produtiva. Quer que eu prepare algo assim?



Não eu estou querendo dizer que você irá estudo de auditoria que está realizando para corrigir o código
Entendi! Vou corrigir o código anterior incorporando as recomendações da auditoria para que esteja mais robusto, seguro e eficiente. Seguem as correções principais aplicadas:

Buscando e usando access_hash quando disponível antes de mandar requisições complementares, evitando usar zero.
Melhor detecção de IDs em múltiplas chaves e estruturas para buscas complementares.
Uso de threading.Event para aguardar as requisições, substituindo o loop ativo.
Proteção por locks ao manipular estruturas compartilhadas (como seen_objects).
Limite dinâmico configurável para profundidade de inspeção e tamanho máximo do JSON.
Logs detalhados para exceções.
Confirmação necessária para copiar dados grandes para a área de transferência.
Avaliação do tamanho do texto antes de exibir no diálogo, exibindo aviso se exceder.
