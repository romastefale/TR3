from typing import Any, Dict, List, Optional, Set
import threading
import json
import logging
import time
from android_utils import run_on_ui_thread
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from client_utils import get_last_fragment, send_request
from ui.bulletin import BulletinHelper
from ui.alert import AlertDialogBuilder
from android.content import ClipboardManager, ClipData
from android.content import Context as AndroidContext
from org.telegram.tgnet import functions, TLRPC
logging.basicConfig(level=logging.DEBUG)
def _safe_attr(obj: Any, name: str, default: Any = None) -> Any:
    try:
        return getattr(obj, name, default)
    except Exception:
        return default
def _to_java_list(value: Any) -> List[Any]:
    if value is None:
        return []
    try:
        return list(value)
    except Exception:
        pass
    try:
        return [value.get(i) for i in range(value.size())]
    except Exception:
        return []
class MTProtoRpcDiagnosticsForensicPlugin(BasePlugin):
    MAX_DEPTH = 8
    MAX_JSON_SIZE = 1024 * 1024 * 2  # 2 MB limite para exibição
    def on_plugin_load(self) -> None:
        self._execution_lock = threading.Lock()
        self._menu_item_id = self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.CHAT_ACTION_MENU,
                text="Diagnóstico Forense (JSON Total Extenso)",
                on_click=self.on_menu_click,
                icon="msg_info",
                subtext="Extrai TODOS os dados possíveis + JSON detalhado",
                priority=5,
            )
        )
        self.log("MTProto Forensic JSON Total Extenso carregado")
    def on_plugin_unload(self) -> None:
        item_id = getattr(self, "_menu_item_id", None)
        if item_id:
            try:
                self.remove_menu_item(item_id)
            except Exception as exc:
                self.log(f"Falha ao remover item: {exc}")
        self.log("MTProto Forensic descarregado")
    def on_menu_click(self, context: Dict[str, Any]) -> None:
        if not self._execution_lock.acquire(blocking=False):
            self._show_info("Diagnóstico já em execução.")
            return
        self._show_info("Extraindo TODOS os dados forenses (extenso)...")
        try:
            threading.Thread(target=self._run_diagnostics, args=(context,)).start()
        except Exception as exc:
            self._execution_lock.release()
            self.log(f"Falha ao iniciar diagnóstico: {exc}")
            self._show_error("Não foi possível iniciar o diagnóstico.")
    def _run_diagnostics(self, context: Dict[str, Any]) -> None:
        start_time = time.time()
        event = threading.Event()
        state = {
            "data": {},
            "seen_objects": set(),
            "pending_reqs": 0,
            "lock": threading.Lock(),
            "event": event,
        }
        data = state["data"]
        try:
            fragment = context.get("fragment")
            if fragment:
                with state["lock"]:
                    data["fragment"] = self._deep_inspect(fragment, state["seen_objects"], state["lock"])
            else:
                data["fragment"] = None
            keys_to_inspect = ["currentChat", "currentUser", "user", "chat", "dialog", "messages", "updates", "dialogs"]
            for key in keys_to_inspect:
                obj = None
                if fragment:
                    obj = getattr(fragment, key, None)
                if obj is None:
                    obj = context.get(key)
                if obj is not None:
                    with state["lock"]:
                        data[key] = self._deep_inspect(obj, state["seen_objects"], state["lock"])
            self._schedule_complementary_requests(data, state)
            # Aguarda requisições complementares com timeout para evitar bloqueio eterno
            if not event.wait(timeout=15):
                self.log("Timeout aguardando requisições complementares completarem")
            data["meta"] = {
                "timestamp": time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(start_time)),
                "duration_seconds": round(time.time() - start_time, 2),
                "app_version": __app_version__,
                "sdk_version": __sdk_version__,
            }
            report = json.dumps(data, indent=2, ensure_ascii=False)
            report_size = len(report.encode("utf-8"))
            if report_size > self.MAX_JSON_SIZE:
                confirmed = self._confirm_copy_large_report(report_size)
            else:
                confirmed = True
            if confirmed:
                copied = self._copy_to_clipboard(report)
                msg_clipboard = "\n\n[✓] JSON copiado para a área de transferência" if copied else "\n\n[!] Falha ao copiar para a área de transferência"
            else:
                msg_clipboard = "\n\n[!] Cópia cancelada pelo usuário."
            self._show_report_dialog(report + msg_clipboard)
        except Exception as exc:
            self.log(f"Erro durante diagnóstico: {exc}", exc_info=True)
            self._show_error("Falha durante o diagnóstico.")
        finally:
            self._execution_lock.release()
    def _deep_inspect(self, obj: Any, seen: Set[int], lock: threading.Lock, depth=0) -> Any:
        if obj is None:
            return None
        if depth > self.MAX_DEPTH:
            return "<profundidade máxima atingida>"
        obj_id = id(obj)
        with lock:
            if obj_id in seen:
                return "<recursão detectada>"
            seen.add(obj_id)
        try:
            if isinstance(obj, (str, int, float, bool)):
                return obj
            if isinstance(obj, (list, tuple)):
                return [self._deep_inspect(i, seen, lock, depth + 1) for i in obj]
            if isinstance(obj, dict):
                return {str(k): self._deep_inspect(v, seen, lock, depth + 1) for k, v in obj.items()}
            fields = getattr(obj, "__dict__", None)
            if fields:
                return {k: self._deep_inspect(v, seen, lock, depth + 1) for k, v in fields.items() if not k.startswith("_")}
            attrs = [a for a in dir(obj) if not a.startswith("_")]
            result = {}
            for attr in attrs:
                try:
                    val = getattr(obj, attr)
                    if callable(val):
                        continue
                    result[attr] = self._deep_inspect(val, seen, lock, depth + 1)
                except Exception:
                    result[attr] = "<erro ao acessar>"
            if result:
                return result
            return str(obj)
        except Exception as e:
            self.log(f"Erro em _deep_inspect: {e}")
            return "<objeto nao serializavel>"
    def _schedule_complementary_requests(self, data: dict, state: dict) -> None:
        def find_ids_recursively(obj):
            found = []
            if isinstance(obj, dict):
                for k, v in obj.items():
                    if k.endswith("_id") and isinstance(v, int) and v > 0:
                        access_hash = None
                        # tenta extrair access_hash próximo ao ID
                        if isinstance(obj, dict):
                            access_hash = obj.get("access_hash", None)
                        found.append((k, v, access_hash))
                    elif isinstance(v, (dict, list)):
                        found.extend(find_ids_recursively(v))
            elif isinstance(obj, list):
                for el in obj:
                    found.extend(find_ids_recursively(el))
            return found
        ids = find_ids_recursively(data)
        if not ids:
            return
        event: threading.Event = state["event"]
        def make_request_user(user_id, access_hash):
            with state["lock"]:
                state["pending_reqs"] += 1
            request = functions.users.GetFullUser()
            input_user = TLRPC.TL_inputUser()
            input_user.user_id = user_id
            input_user.access_hash = access_hash if access_hash else 0
            request.id = input_user
            def callback(response, error):
                with state["lock"]:
                    if error or response is None:
                        state["data"].setdefault("full_users_errors", {})[user_id] = str(error)
                    else:
                        state["data"].setdefault("full_users", {})[user_id] = self._deep_inspect(response, state["seen_objects"], state["lock"])
                    state["pending_reqs"] -= 1
                    if state["pending_reqs"] == 0:
                        event.set()
            try:
                send_request(request, callback)
            except Exception as exc:
                with state["lock"]:
                    state["data"].setdefault("full_users_errors", {})[user_id] = str(exc)
                    state["pending_reqs"] -= 1
                    if state["pending_reqs"] == 0:
                        event.set()
        def make_request_channel(channel_id, access_hash):
            with state["lock"]:
                state["pending_reqs"] += 1
            request = functions.channels.GetFullChannel()
            input_channel = TLRPC.TL_inputChannel()
            input_channel.channel_id = channel_id
            input_channel.access_hash = access_hash if access_hash else 0
            request.channel = input_channel
            def callback(response, error):
                with state["lock"]:
                    if error or response is None:
                        state["data"].setdefault("full_channels_errors", {})[channel_id] = str(error)
                    else:
                        state["data"].setdefault("full_channels", {})[channel_id] = self._deep_inspect(response, state["seen_objects"], state["lock"])
                    state["pending_reqs"] -= 1
                    if state["pending_reqs"] == 0:
                        event.set()
            try:
                send_request(request, callback)
            except Exception as exc:
                with state["lock"]:
                    state["data"].setdefault("full_channels_errors", {})[channel_id] = str(exc)
                    state["pending_reqs"] -= 1
                    if state["pending_reqs"] == 0:
                        event.set()
        for key, id_value, access_hash in ids:
            # Decide tipo da requisição conforme chave
            if "user" in key:
                make_request_user(id_value, access_hash)
            elif "channel" in key or "chat" in key:
                make_request_channel(id_value, access_hash)
    def _show_report_dialog(self, report: str) -> None:
        MAX_MINIMAL_SIZE_TO_USE_DIALOG = 500 * 1024  # 500 KB; acima disso, evitar diálogo por UI travada
        def show() -> None:
            fragment = get_last_fragment()
            if fragment is None:
                self._show_error("Tela atual indisponível.")
                return
            activity = fragment.getParentActivity()
            if activity is None:
                self._show_error("Atividade indisponível.")
                return
            builder = AlertDialogBuilder(activity)
            builder.set_title("Diagnóstico Forense (JSON Total Extenso)")
            if len(report.encode("utf-8")) > MAX_MINIMAL_SIZE_TO_USE_DIALOG:
                builder.set_message("Relatório muito grande para exibir na tela.\nFavor copiar ou salvar o arquivo.")
            else:
                builder.set_message(report)
            builder.set_positive_button("Fechar", lambda d, w: d.dismiss())
            builder.show()
        run_on_ui_thread(show)
    def _copy_to_clipboard(self, text: str) -> bool:
        fragment = get_last_fragment()
        if fragment is None:
            self.log("Fragmento indisponível para copiar.")
            return False
        activity = fragment.getParentActivity()
        if activity is None:
            self.log("Atividade indisponível para copiar.")
            return False
        try:
            clipboard = activity.getSystemService(AndroidContext.CLIPBOARD_SERVICE)
            if clipboard is None:
                self.log("Clipboard service não disponível.")
                return False
            clip = ClipData.newPlainText("MTProto Forensic JSON", text)
            clipboard.setPrimaryClip(clip)
            return True
        except Exception as exc:
            self.log(f"Erro ao copiar para área de transferência: {exc}")
            return False
    def _confirm_copy_large_report(self, size_bytes: int) -> bool:
        # Implementa prompt simples (placeholder) para usuário confirmar copy de arquivos grandes.
        # Aqui apenas demonstra a ideia; o ideal é mostrar diálogo real para o usuário.
        # Como não temos UI síncrona, assumimos sempre confirmação:
        self.log(f"Relatório grande ({size_bytes / 1024:.2f} KB). Confirmar para copiar (simulado: sim).")
        return True
    @staticmethod
    def _show_info(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_info(msg))
    @staticmethod
    def _show_error(msg: str) -> None:
        run_on_ui_thread(lambda: BulletinHelper.show_error(msg))
Se desejar, posso ajudar a implementar uma interface real para a confirmação, melhorar o controle de tamanho de JSON, ou estender a inteligência na identificação de IDs e access_hash — além, claro, de ajudar em testes e integração no seu ambiente. Quer?



Antes de interface quero que você mantenha na entrega do produto então sim você irá pelo caminho do tratamento de código sensíveis não apenas ideia ou Hashi mas tokens também
Entendido! Para manter a entrega do produto focado em tratamento e proteção de dados sensíveis, vou adicionar no código uma camada que detecta e anonimiza automaticamente informações sensíveis antes de gerar o JSON final. Isso inclui:

Tokens, senhas, chaves, hashes e qualquer campo cujo nome sugira dados sensíveis;
Dados pessoais críticos, como números de telefone e e-mails (podemos anonimizar ou mascarar);
Campos ou valores que pareçam conter informações privadas, baseados em padrões comuns.
Essa anonimização será configurável, para permitir ajustar níveis de proteção conforme necessidade, sempre preservando o máximo de dados úteis para diagnóstico.

Como atuará na prática?

Antes do JSON ser construído, o plugin percorre todo o resultado recursivamente e substitui valores sensíveis por "<PROTECTED>" ou similar.
Os campos originais nunca sairão expostos, reduzindo risco em análises externas ou armazenamento.
Permite revisão segura do relatório, sem perder contexto estrutural.
Trecho principal que adicionei (função de anonimização):

python


def _anonymize_sensitive_data(self, obj: Any, depth=0, max_depth=8, seen=None) -> Any:
    if seen is None:
        seen = set()
    if depth > max_depth:
        return "<max-depth-reached>"
    obj_id = id(obj)
    if obj_id in seen:
        return "<recursion>"
    seen.add(obj_id)
    sensitive_keys = {
        "password", "pass", "passwd", "token", "auth", "secret", "hash", "key", "access_hash",
        "phone", "email", "session", "api_id", "api_hash", "dc_id", "auth_key",
    }
    try:
        if isinstance(obj, dict):
            new_dict = {}
            for k, v in obj.items():
                k_lower = str(k).lower()
                if any(sens_key in k_lower for sens_key in sensitive_keys):
                    new_dict[k] = "<PROTECTED>"
                else:
                    new_dict[k] = self._anonymize_sensitive_data(v, depth + 1, max_depth, seen)
            return new_dict
        elif isinstance(obj, list):
            return [self._anonymize_sensitive_data(i, depth + 1, max_depth, seen) for i in obj]
        elif isinstance(obj, (str, int, float, bool)) or obj is None:
            return obj
        else:
            # Para outros objetos, tenta dict ou str
            fields = getattr(obj, "__dict__", None)
            if fields:
                new_obj = {}
                for k, v in fields.items():
                    if any(sens_key in k.lower() for sens_key in sensitive_keys):
                        new_obj[k] = "<PROTECTED>"
                    else:
                        new_obj[k] = self._anonymize_sensitive_data(v, depth + 1, max_depth, seen)
                return new_obj
            else:
                return obj
    except Exception:
        return "<anonymization-error>"
Como inserir no fluxo existente?

Após coletar e montar o data com todos os dados e requisições, antes de serializar com json.dumps, o plugin deve chamar:

python


cleaned_data = self._anonymize_sensitive_data(data)
report = json.dumps(cleaned_data, indent=2, ensure_ascii=False)
Assim o JSON gerado jamais expõe dados sensíveis.

Quer que gere o código completo já com essa função integrada no fluxo, para você já ter a versão pronta para usar?



Você entendeu entendeu errado eu quero a a entrega dos dados sensíveis
Entendi agora, você quer que o plugin entregue os dados sensíveis na íntegra, com tudo que a SDK disponibiliza, sem anonimização ou filtro — exatamente para extrair o máximo possível, inclusive tokens, hashes, senhas, etc.

Ou seja, o objetivo é obter todos os dados brutos, sem nenhuma remoção ou mascaramento, para uma análise forense completa.

Neste caso, o código entregue anteriormente já segue esse conceito: ele extrai todos os dados acessíveis, recursivamente, inclusive campos sensíveis, e inclui tudo no JSON final.

Posso reforçar que:

O plugin não elimina, filtra ou oculta nenhum campo.
Tudo que está acessível nos objetos do SDK e contexto será serializado.
Tokens, access_hash, senhas e demais estarão presentes, se existirem no objeto.
Os callbacks das requisições complementares também retornarão os dados inteiros.
Se quiser, posso ajudar a:

Confirmar que nenhuma anonimização ou filtro foi aplicado em nenhuma função.
Garantir que o processamento recursivo percorre todas as propriedades e listas, sem exceção.
Ajustar seu uso para garantir que todos os dados sensíveis presentes na sessão sejam de fato capturados.
Quer?



Quero
Aqui está um resumo para garantir que todos os dados, inclusive os sensíveis, sejam capturados e entregues integralmente pelo plugin, sem qualquer filtro ou anonimização. O código fornecido anteriormente já está configurado para isso, e reforço os pontos essenciais que garantem a captura total:

Pontos que asseguram entrega completa dos dados sensíveis

Inspeção recursiva profunda (_deep_inspect):

Explora todos os atributos públicos, listas, dicionários e objetos aninhados, respeitando limites para evitar loops infinitos, sem excluir ou alterar dados.
Não aplica nenhum filtro ou mascaramento de dados.
Requisições complementares (GetFullUser, GetFullChannel):

São disparadas para IDs encontrados dinamicamente no JSON inspecionado, trazendo toda informação detalhada disponível no servidor, que inclui campos sensíveis como access_hash, tokens, configurações, etc.
Serialização direta:

Dados são convertidos para JSON com json.dumps, sem etapa prévia de modificação ou exclusão de campos.
Armazenamento e visualização:

JSON gerado é mostrado ao usuário e copiado para clipboard com todo o conteúdo intacto.
Confirmação prática

O trecho da função _deep_inspect, que faz o trabalho de leitura, não tem lógica que altere ou omita dados, apenas converte tipos e evita recursão:

python


def _deep_inspect(self, obj: Any, seen: Set[int], lock: threading.Lock, depth=0) -> Any:
    #... percorre recursivamente sem filtrar nada sensível ...
As requisições complementares também não filtram dados antes de agregar:

python


state["data"].setdefault("full_users", {})[user_id] = self._deep_inspect(response, ...)
Você pode garantir que não existe nenhuma função de anonimização, filtro nem lógica que apague ou altere campos sensíveis.

